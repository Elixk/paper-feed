    &lt;div style=&quot;font-size:12px;letter-spacing:1.6px;text-transform:uppercase;color:#bfdbfe;margin-bottom:6px;&quot;&gt;Research Literature Digest&lt;/div&gt;
    &lt;h1 style=&quot;margin:0 0 10px;font-size:29px;line-height:1.25;font-weight:750;&quot;&gt;Daily AI Literature Insights&lt;/h1&gt;
    &lt;p style=&quot;margin:0;color:#dbeafe;font-size:14px;&quot;&gt;按用户研究方向优先级整理的每日文献洞察&lt;/p&gt;
    &lt;div style=&quot;display:flex;flex-wrap:wrap;gap:8px;margin-top:18px;&quot;&gt;
      &lt;span style=&quot;display:inline-block;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,0.12);font-size:12px;&quot;&gt;生成时间：2026-07-30 08:29 UTC&lt;/span&gt;
      &lt;span style=&quot;display:inline-block;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,0.12);font-size:12px;&quot;&gt;候选论文：100&lt;/span&gt;
      &lt;span style=&quot;display:inline-block;padding:6px 10px;border-radius:999px;background:#2563eb;font-size:12px;font-weight:700;&quot;&gt;入选论文：23&lt;/span&gt;
    &lt;/div&gt;
